
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Add Employee - Payroll Manager</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body class="add-employee-page">

    <main class="employee-form-wrapper">
        <header class="employee-form-header">
            <h1>Add Employee</h1>
            <p>Enter the employee's personal and employment details.</p>
        </header>

        <% if (errors && errors.length > 0) { %>
            <div class="error">
                <% errors.forEach(error => { %>
                    <p><%= error %></p>
                <% }) %>
            </div>
        <% } %>

        <form method="POST" action="/add" class="employee-form">

            <label for="name">Employee Name *</label>
            <input
                type="text"
                id="name"
                name="name"
                placeholder="Enter employee name"
                value="<%= formData.name || '' %>"
                minlength="2"
                maxlength="60"
                pattern="[A-Za-z][A-Za-z .'-]*"
                required
            >

            <label for="email">Email Address</label>
            <input
                type="email"
                id="email"
                name="email"
                placeholder="employee@example.com"
                value="<%= formData.email || '' %>"
                maxlength="120"
            >

            <label for="phone">Phone Number</label>
            <input
                type="tel"
                id="phone"
                name="phone"
                placeholder="9876543210"
                value="<%= formData.phone || '' %>"
                inputmode="numeric"
                pattern="[6-9][0-9]{9}"
                minlength="10"
                maxlength="10"
                title="Enter exactly 10 digits starting with 6, 7, 8 or 9."
            >

            <p class="field-hint">
                Enter a 10-digit Indian mobile number without +91 or spaces.
            </p>

            <label for="designation">Designation</label>
            <input
                type="text"
                id="designation"
                name="designation"
                placeholder="e.g. Software Engineer"
                value="<%= formData.designation || '' %>"
                maxlength="60"
            >

            <label for="department">Department *</label>
            <input
                type="text"
                id="department"
                name="department"
                placeholder="Enter department"
                value="<%= formData.department || '' %>"
                minlength="2"
                maxlength="40"
                pattern="[A-Za-z][A-Za-z &-]*"
                required
            >

            <label for="joiningDate">Joining Date</label>
            <input
                type="date"
                id="joiningDate"
                name="joiningDate"
                value="<%= formData.joiningDate || '' %>"
            >

            <label for="basicSalary">Basic Salary (₹) *</label>
            <input
                type="number"
                id="basicSalary"
                name="basicSalary"
                placeholder="Enter basic salary"
                step="0.01"
                min="0.01"
                max="1000000000"
                value="<%= formData.basicSalary || '' %>"
                required
            >

            <div class="form-actions">
                <button type="submit">Add Employee</button>
                <a href="/">Cancel</a>
            </div>

        </form>
    </main>

</body>
</html>
