
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Edit Employee - Payroll Manager</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <h1>Edit Employee</h1>
    <p>Update the employee details below.</p>

    <% if (errors && errors.length > 0) { %>
        <div class="error">
            <% errors.forEach(error => { %>
                <p><%= error %></p>
            <% }) %>
        </div>
    <% } %>

    <form method="POST" action="/edit/<%= employee.id %>">
        <label for="name">Employee Name</label>
        <input
            type="text"
            id="name"
            name="name"
            value="<%= formData.name !== undefined ? formData.name : employee.name %>"
            required
        >

        <label for="department">Department</label>
        <input
            type="text"
            id="department"
            name="department"
            value="<%= formData.department !== undefined ? formData.department : employee.department %>"
            required
        >

        <label for="basicSalary">Basic Salary (₹)</label>
        <input
            type="number"
            id="basicSalary"
            name="basicSalary"
            step="0.01"
            min="0.01"
            value="<%= formData.basicSalary !== undefined ? formData.basicSalary : employee.basicSalary %>"
            required
        >

        <button type="submit">Update Employee</button>
    </form>

    <br>
    <a href="/">Back to Dashboard</a>

</body>
</html>
